# Copy this file to `.env` at the repo root before running `docker compose up --build`.
# docker-compose reads this file to fill in the ${VARS} referenced in docker-compose.yml.
# Do NOT commit `.env`.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=nawydb

# Must match the postgres credentials above; "db" is the docker-compose service name.
DATABASE_URL=postgres://postgres:postgres@db:5432/nawydb

PORT=4000
LOG_LEVEL=info

# Baked into the frontend's client bundle at build time - use the backend's
# externally reachable URL (localhost when running via docker-compose on your
# own machine), not the internal "backend" service hostname.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
